# Before anything, load wal
if [[ -z $SSH_CONNECTION && -z $SSH_TTY ]]; then
  (cat "$HOME/.cache/wal/sequences" &) 2>/dev/null
  source "$HOME/.cache/wal/colors-tty.sh" 2>/dev/null
fi

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Path to ZINIT installation.
ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"
if [ ! -d "$ZINIT_HOME" ]; then
  mkdir -p "$(dirname $ZINIT_HOME)"
  git clone https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME"
fi

source "${ZINIT_HOME}/zinit.zsh"

# p10k for zinit
zinit ice depth=1; zinit light romkatv/powerlevel10k

# Other plugins
zinit light zsh-users/zsh-syntax-highlighting
zinit light zsh-users/zsh-completions
zinit light zsh-users/zsh-autosuggestions
zinit light Aloxaf/fzf-tab
zinit snippet OMZP::git
zinit snippet OMZP::pip
zinit snippet OMZP::sudo
zinit snippet OMZP::colored-man-pages
zinit snippet OMZP::command-not-found
zinit snippet OMZP::web-search

# Load completions
autoload -Uz compinit
compinit -C
# Case insensitive completion
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
# Completion coloring
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
# Disable default completion menu in favor of fzf-tab
zstyle ':completion:*' menu no
# Show directory preview in fzf-tab
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'ls --color $realpath'

# Configure history
HISTSIZE=5000
HISTFILE=~/.zsh_history
SAVEHIST=$HISTSIZE
HISTDUP=erase
setopt appendhistory
setopt sharehistory
setopt hist_ignore_space
setopt hist_ignore_all_dups
setopt hist_save_no_dups
setopt hist_ignore_dups
setopt hist_find_no_dups
bindkey '^p' history-search-backward
bindkey '^n' history-search-forward

# Fix navigation keys inside tmux / kitty
# Detect termcap codes
bindkey -e

# Home / End
bindkey "${terminfo[khome]}" beginning-of-line
bindkey "${terminfo[kend]}" end-of-line

# Fallbacks for terminals that don't populate terminfo
bindkey "^[[1;5D" backward-word   # Ctrl+Left
bindkey "^[[1;5C" forward-word    # Ctrl+Right
bindkey "^[[H" beginning-of-line  # Home
bindkey "^[[F" end-of-line        # End

export OUTER_TERM="${TERM:-}"
if [ -n "${TMUX-}" ]; then
  export OUTER_TERM="$(tmux display-message -p '#{client_termname}')"
fi

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
if [[ $OUTER_TERM == "linux" ]]; then
  [[ ! -f ~/.p10k-tty.zsh ]] || source ~/.p10k-tty.zsh
else
  [[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
  # Ctrl + Left / Right for word jumps
  bindkey "${terminfo[kLFT5]}" backward-word
  bindkey "${terminfo[kRIT5]}" forward-word
fi

# Neovim, from whichever install this machine has: the system-wide tarball under
# /opt, or the user-local one that `install.sh --user-only` unpacks into
# ~/.local/opt. The release tarballs name the architecture differently from
# uname, hence the mapping.
#
# The paths are spelled out rather than globbed on purpose. /opt may be mode 711
# on hardened hosts, which allows traversal but not listing. A glob has to list
# the directory and so matches nothing there, while testing a known path only
# needs traversal.
case $CPUTYPE in
aarch64 | arm64) _nvim_arch=arm64 ;;
*) _nvim_arch=x86_64 ;;
esac
for _nvim_bin in /opt/nvim-linux-$_nvim_arch/bin $HOME/.local/opt/nvim-linux-$_nvim_arch/bin; do
  [[ -d $_nvim_bin ]] && export PATH="$_nvim_bin:$PATH"
done
unset _nvim_arch _nvim_bin

# User-local binaries. Last, so a --user-only install wins over a stale
# system-wide copy of the same tool.
export PATH="$HOME/.local/bin:$PATH"

# Node
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

# Map Ctrl + Backspace to delete the previous word
bindkey '^H' backward-kill-word

export EDITOR='nvim'
# Custom aliases
# Editor
alias ef='$EDITOR'
alias e='$EDITOR .'
alias edot='$EDITOR $HOME/dotfiles'
alias elsp='$EDITOR $HOME/dotfiles/nvim/lua/config/lsp.lua'
# File management
alias ls='eza'
# Print files in order of size
alias lss='eza -l --group-directories-first --icons --time-style=long-iso --total-size --sort=size'
# Print files in order of modification time
alias lsm='eza -l --group-directories-first --icons --time-style=long-iso --total-size --sort=modified'
alias lsn='eza -l --group-directories-first --icons --time-style=long-iso --total-size --sort=name'
alias lse='eza -l --group-directories-first --icons --time-style=long-iso --total-size --sort=extension'
alias lst='eza -l --group-directories-first --icons --time-style=long-iso --total-size --sort=type'
# Other coreutils alternatives.
#
# Debian and Ubuntu rename both of these to avoid clashing with existing
# packages (bat -> batcat, fd -> fdfind); Arch and Fedora ship the upstream
# names. Picking at startup means one rc file works on all of them, instead of
# aliasing to a binary that is not installed and shadowing the one that is -
# which is what `alias fd=fdfind` was doing on Arch, hiding the real fd.
if (( $+commands[batcat] )); then
  alias cat="batcat"
elif (( $+commands[bat] )); then
  alias cat="bat"
fi

# Find files
(( $+commands[fdfind] )) && alias fd="fdfind"

# Terminal bell
alias ding='echo -ne "\a"'

# tmux attach or new
alias ta='tmux attach || tmux new'

# untars a .tar.gz or .tgz into a directory with the same root name
function untar() {
  local archive="$1"
  local dir

  if [[ ! -f "$archive" ]]; then
    echo "File not found: $archive" >&2
    return 1
  fi

  case "$archive" in
    *.tar.gz)  dir="${archive%.tar.gz}" ;;
    *.tgz)     dir="${archive%.tgz}" ;;
    *.tar.bz2) dir="${archive%.tar.bz2}" ;;
    *.tbz2)    dir="${archive%.tbz2}" ;;
    *.tar.xz)  dir="${archive%.tar.xz}" ;;
    *.txz)     dir="${archive%.txz}" ;;
    *.tar.zst) dir="${archive%.tar.zst}" ;;
    *.tar)     dir="${archive%.tar}" ;;
    *)
      echo "Unsupported archive type: $archive" >&2
      return 1
      ;;
  esac

  mkdir -p "$dir" || return 1
  tar -xf "$archive" -C "$dir" || return 1
  rm -f -- "$archive"
}

# tars a directory into a .tar.gz with the same root name
function tarit() {
  if [ -d "$1" ]; then
    local dir="${1%/}"
    tar -czf "$dir.tar.gz" -C "$dir" .
    rm -rf "$dir"
  else
    echo "Directory not found: $1"
  fi
}

# Use gnome keyring for secrets. Without a proper DE, you can use `secret-tool`
# to add passwords to the keyring.
# See https://wiki.archlinux.org/title/GNOME/Keyring
# and https://bbs.archlinux.org/viewtopic.php?pid=2217761#p2217761
if ! pgrep -u "$USER" -f gnome-keyring-daemon > /dev/null; then
  eval $(gnome-keyring-daemon --start 2>/dev/null)
fi

# Point ssh at whichever agent this session actually provides.
#
# This used to be a bare `export SSH_AUTH_SOCK`, which exports an *empty*
# value - so ssh saw no agent, ignored the unlocked keys, and fell back to
# asking for the passphrase through ssh-askpass. In a non-interactive context
# (a git fetch from an editor or a script) there is no askpass binary, so it
# just failed with "Permission denied (publickey)".
#
# It was also aimed at the wrong agent: gnome-keyring dropped its ssh
# component in 42, and `gnome-keyring-daemon --components` now offers only
# pkcs11 and secrets. The replacement is gcr-ssh-agent, socket-activated by
# systemd --user; plain ssh-agent.socket is the fallback elsewhere.
#
# A value inherited from the session (a DE, or an agent started by hand) wins,
# so this only fills in a gap rather than overriding a working setup.
if [[ -z "$SSH_AUTH_SOCK" ]]; then
  for _ssh_sock in \
    "${XDG_RUNTIME_DIR:-/run/user/$UID}/gcr/ssh" \
    "${XDG_RUNTIME_DIR:-/run/user/$UID}/ssh-agent.socket" \
    "${XDG_RUNTIME_DIR:-/run/user/$UID}/keyring/ssh"; do
    if [[ -S "$_ssh_sock" ]]; then
      export SSH_AUTH_SOCK="$_ssh_sock"
      break
    fi
  done
  unset _ssh_sock
fi

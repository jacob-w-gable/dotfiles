#!/usr/bin/env bash
#
# Used memory as a percentage and a single bar glyph.
#
# Used is total minus MemAvailable, which counts reclaimable page cache as
# free. That matches what the awesome ram graph plots.

set -euo pipefail
source "$(dirname "$(readlink -f "$0")")/dwm-bar-lib"

total=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)
avail=$(awk '/^MemAvailable:/ {print $2}' /proc/meminfo)

pct=$(( (total - avail) * 100 / total ))
used_gb=$(awk -v kb=$((total - avail)) 'BEGIN { printf "%.1f", kb / 1048576 }')

printf '%s %s %sG\n' "$(paint accent 'RAM')" "$(spark "$pct")" "$used_gb"

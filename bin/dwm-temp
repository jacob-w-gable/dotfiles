#!/usr/bin/env bash
#
# CPU temperature, from the same thermal zone widgets/cputemp.lua polls.
#
# Turns the accent color red past 80C, which the awesome widget does not do.
# The status bar has no tooltip to put the number in context, so the color is
# the only place a warning can go.

set -euo pipefail
source "$(dirname "$(readlink -f "$0")")/dwm-bar-lib"

readonly zone=/sys/class/thermal/thermal_zone0/temp

if [[ ! -r $zone ]]; then
    printf '%s\n' "$(paint muted '--°C')"
    exit 0
fi

celsius=$(( $(< "$zone") / 1000 ))

role=accent
(( celsius >= 80 )) && role=urgent

printf '%s\n' "$(paint "$role" "${celsius}°C")"

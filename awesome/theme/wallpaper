#!/usr/bin/env bash
set -euo pipefail

# Ensure your user bin is visible when started from Awesome (non-interactive env)
export PATH="$HOME/.local/bin:$PATH"

# Optional: log to see what actually happens when launched via Awesome
exec >/tmp/wallpaper.log 2>&1

mkdir -p "$HOME/Pictures/Wallpapers"

# Let nsxiv print the selected path to stdout (works w/o a TTY)
IMAGE="$(nsxiv -obtn 1 -z 120 "$HOME"/Pictures/Wallpapers/* || true)"
if [ -z "${IMAGE:-}" ]; then
  echo "No image selected."
  exit 1
fi
echo "Selected image: $IMAGE"

# Generate pywal cache (colors.json, templates, etc.)
#
# The wal backend needs ImageMagick to reduce the image to at least 16 distinct
# colors. On a tonally flat image, like a smooth gradient, ImageMagick merges
# near-identical colors and returns fewer, so wal gives up. colorthief's median
# cut handles those images. It's only the fallback, so every other wallpaper
# keeps the palette the wal backend gives it. colorthief isn't a pywal
# dependency and is added with `pipx inject pywal16 colorthief`.
if ! wal -i "$IMAGE" --cols16 lighten; then
  echo "wal backend failed; retrying with colorthief"
  wal -i "$IMAGE" --cols16 lighten --backend colorthief
fi

# Colorize keyboard
if command -v rgb_ctrl >/dev/null 2>&1; then
  COLOR=$(jq -r '.colors.color4' "$HOME/.cache/wal/colors.json")
  rgb_ctrl hex "$COLOR" || true
fi

# Need to sleep to wait for the wallpaper to set
sleep 2

# Rebuild the lock screen from the image that was just selected. A failure here
# leaves the previous lock screen in place, which is worth strictly less than
# the theme updates below, so it must not take the rest of the script down.
"$HOME/.config/awesome/theme/lockscreen" --force || echo "Lock screen rebuild failed."

# Update Chromium theme
(cd $HOME/dotfiles/chromium && ./pywal-theme.sh)

# Update GTK theme
python3 $HOME/dotfiles/awesome/theme/gtk2css.py -f $HOME/.cache/wal/gtk.json

# Update QT theme
awk '
/_colors=$/ {                               # start of a colors block
  if (key) print key line "\n"               # flush previous
  key=$0; line=""; next
}
/^#/ && key {                               # color lines inside block
  sub(/^[[:space:]]+|[[:space:]]+$/, "")
  gsub(/,$/, ",")                            # ensure commas stay
  line = line $0
  next
}
/^\[/ {                                     # section header
  if (key) print key line "\n"; key=""; line=""
  print $0; next
}
END { if (key) print key line "\n" }' $HOME/.cache/wal/qt5ct.conf >$HOME/.config/qt5ct/colors/awesomewm.conf

# GTK and Qt apps read their colours through xdg-desktop-portal, which caches
# them, so already-running apps keep the old theme until it is restarted. Each
# backend is optional - a machine with only one of them installed must not have
# the rest of this script taken down by the missing unit.
for unit in xdg-desktop-portal xdg-desktop-portal-gtk xdg-desktop-portal-kde; do
  systemctl --user restart "$unit.service" 2>/dev/null || true
done

# Update on-screen keyboard theme. Onboard reads themes from its own data
# directory rather than ~/.config, so this copies rather than symlinks. It is a
# no-op on a machine with no Onboard installed.
"$HOME/.config/awesome/scripts/onboard-pywal-theme.sh" || echo "Onboard theme update failed."

# Detach the restart so Awesome doesn't kill this script early
setsid bash -lc 'sleep 0.15; awesome-client "awesome.restart()"' >/dev/null 2>&1 &
